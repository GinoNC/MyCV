<!DOCTYPE html>
<html lang="jp">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NG CHI WING, Gino's Info</title>

    <base href="/" />

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WebBlazor.styles.css"]" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" />
    <ImportMap />
    
    <HeadOutlet @rendermode="InteractiveServer" />

    <style>
        *, ::after, ::before {
            box-sizing:border-box;
        }
        body {
            line-height:initial;
            overflow:initial!important;
        }
        hr {
            margin:0.5em 0 0.5em 0!important;
        }
        .components-reconnect-modal .components-reconnect-show, .components-reconnect-failed, .components-reconnect-rejected {
            display:none;
        }
        .bm-container {
            display:inline-flex!important;
            justify-content:center!important;
        }
        .size-medium {
            max-width:initial!important;
            margin-left:initial!important;
            margin-right:initial!important;
        }

        #blazor-error-ui {
            display:none!important;
        }
    </style>
</head>

<body data-theme="light">
    <Routes @rendermode="InteractiveServer" />

    <div id="components-reconnect-modal"></div>
    
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>