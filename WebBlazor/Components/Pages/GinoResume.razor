@using WebBlazor.Classes
@using WebBlazor.Components.Layout

<link rel="stylesheet" href="@Assets["resume.css"]" />


<section class="proarea">
    <div class="pro1">
        <div class="reshd">
            <div class="restit">@Cap.re_subject</div>
            <div class="resdate">@DateTime.Today.ToString("yyyy-MM-dd")</div>
        </div>

        <div class="furi-r">
            <div class="imlbl">ふりがな</div>
            <div class="furiin">ご しえい</div>
        </div>

        <div class="name-r">
            <div class="imlbl">@Cap.re_name</div>
            <div class="nalbl">NG CHI WING</div>
        </div>

        <div class="bas">
            <div class="bascell">
                <div class="imlbl">@Cap.re_birth</div>
                <div>1983-01-24 @Cap.re_age</div>
            </div>

            <div class="bascell">
                <div class="imlbl">@Cap.re_nation</div>
                <div>@Cap.re_british</div>
            </div>

            <div class="bascell gender">
                <span class="gender-circle">@Cap.re_male</span> / @Cap.re_female
            </div>
        </div>
    </div>


    <div class="pro2">
        <div class="pho">
            <img src="https://storage.googleapis.com/ginogcp/cps.png" alt="" />
        </div>
    </div>


    <div class="addre-left">
        <div class="addre-furi">
            <div class="imlbl">ふりがな</div>
            <div class="furiin">とうきょうとあだちくにしあらい５の２９の５－８０４ごう</div>
        </div>

        <div class="addre-content">
            <div class="imlbl">
                @Cap.re_address
            </div>

            <div class="addre-value">
                〒 123-0841<br />
                @((MarkupString)Cap.re_location)
            </div>
        </div>

    </div>


    <div class="addre-right">
        <div class="contitem">
            <span class="imlbl">@Cap.re_mobile</span><br />
            070-1180-0533
        </div>

        <div class="contitem">
            <span class="imlbl">@Cap.re_email</span><br />
            ngcwing22@yahoo.co.jp
        </div>
    </div>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th class="hdy">@Cap.re_year</th>
                <th class="hdm">@Cap.re_month</th>
                <th>@Cap.re_quali</th>
            </tr>
        </thead>

        <tbody>
            <HistoryItem txtYear="1995" txtMonth="9" txtDesc=@("Aberdeen Baptist Lui Ming Choi College (HK) - " + Cap.re_quali_entry) />
            <HistoryItem txtYear="2000" txtMonth="6" txtDesc=@("Aberdeen Baptist Lui Ming Choi College (HK) - " + Cap.re_quali_grad) />
            <HistoryItem txtYear="2000" txtMonth="9" txtDesc=@("Chu Hoi College (HK) - " + Cap.re_quali_entry) />
            <HistoryItem txtYear="2002" txtMonth="3" txtDesc=@("Chu Hoi College (HK) - " + Cap.re_quali_with) />
            <HistoryItem txtYear="2026" txtMonth="8" txtDesc=@("NCC Level 5 Diploma in Computing - " + Cap.re_quali_obta) />
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th class="hdy">@Cap.re_year</th>
                <th class="hdm">@Cap.re_month</th>
                <th>@Cap.re_work</th>
            </tr>
        </thead>

        <tbody>
            <HistoryItem txtYear="2007" txtMonth="5" txtDesc=@("Centaline Property Agency Limited (HK) - " + Cap.re_work_join) />
            <HistoryItem txtYear="2017" txtMonth="7" txtDesc=@("Centaline Property Agency Limited (HK) - " + Cap.re_work_leave) />
            <HistoryItem txtYear="2017" txtMonth="12" txtDesc=@("Ricacorp Properties Limited (HK) - " + Cap.re_work_join) />
            <HistoryItem txtYear="2020" txtMonth="9" txtDesc=@("Ricacorp Properties Limited (HK) - " + Cap.re_work_leave) />
            <HistoryItem txtYear="2020" txtMonth="10" txtDesc=@("RINGOBAKO CO. LIMITED (HK) - " + Cap.re_work_join) />
            <HistoryItem txtYear="2022" txtMonth="4" txtDesc=@("RINGOBAKO CO. LIMITED (HK) - " + Cap.re_work_leave) />
            <HistoryItem txtYear="2022" txtMonth="5" txtDesc=@("株式会社みかん箱 Mikanbako Corp. - " + Cap.re_work_join) />
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th class="hdy">@Cap.re_year</th>
                <th class="hdm">@Cap.re_month</th>
                <th>@Cap.re_cert</th>
            </tr>
        </thead>

        <tbody>
            <HistoryItem txtYear="2006" txtMonth="9" txtDesc="Hong Kong Estate Agents Authority - Salesperson's Licence" />
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th>@Cap.re_note</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@((MarkupString)Cap.re_note_mess)</td>
            </tr>
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th>@Cap.re_apply</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @((MarkupString)Cap.re_apply_mess)
                </td>
            </tr>
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th>@Cap.re_remark</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Cap.re_remark_mess</td>
            </tr>
        </tbody>
    </table>
</section>


<section>
    <table class="restbl">
        <thead>
            <tr>
                <th>@Cap.sa_project</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <a href="https://www.gcjelly.tokyo/gino-info" target="_blank">@Cap.sa_project_recv</a><br /><br />
                    GitHub: <a href="https://github.com/GinoNC/MyCV" target="_blank">@Cap.sa_project_sou</a>
                </td>
            </tr>
        </tbody>
    </table>
</section>


@code {
    [Parameter]
    public LangCaption Cap { get; set; } = new();
}